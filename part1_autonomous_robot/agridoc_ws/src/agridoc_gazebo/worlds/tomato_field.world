<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tomato_field">

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- soil -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.45 0.32 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- fence around the field, 9 m x 5.6 m -->
    <model name="fence">
      <static>true</static>
      <link name="north">
        <pose>3.0 2.8 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>9.0 0.05 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.0 0.05 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>3.0 -2.8 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>9.0 0.05 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.0 0.05 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>7.5 0.0 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 5.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 5.6 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>-1.5 0.0 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 5.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 5.6 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 4 rows of tomato plants, 1.4 m between rows, 0.6 m between plants -->
    <include>
      <uri>model://tomato_plant</uri>
      <name>plant_1_1</name>
      <pose>1.0 -2.1 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tomato_plant</uri>
      <name>plant_1_2</name>
      <pose>1.6 -2.1 0 0 0 0</pose>
    </include>
    <include>
